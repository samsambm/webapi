# Copy to .env and fill in. Never commit the real file.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=          # Settings -> API -> service_role. Server only, never in the app.
SUPABASE_JWT_SECRET=           # Settings -> API -> JWT Secret
ANTHROPIC_API_KEY=             # console.anthropic.com
BILLING_WEBHOOK_SECRET=        # any long random string; the payment adapter sends it back
CHECKOUT_URL=                  # the payment page the app opens for an upgrade
SCAN_MODEL=claude-opus-5
FREE_SCANS_PER_MONTH=5
PRO_SCANS_PER_MONTH=1000
ALLOWED_ORIGINS=*
